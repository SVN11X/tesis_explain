{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["web/src/**/*", ".astro/types.d.ts"],
  "exclude": ["node_modules", "build", "web/public", "js", "herramientas"]
}
