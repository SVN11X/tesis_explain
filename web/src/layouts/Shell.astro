---
import '../styles/experience.css';
// Cabecera, aviso académico, pie y buscador comunes a todo el sitio: herramientas/datos.py los genera desde
// herramientas/plantillas/, igual que en las páginas de la guía.
import marco from '../generado/marco.json';
const {title, description, page='inicio'} = Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical=new URL(page==='inicio'?'':`${page}.html`,'https://svn11x.github.io/tesis_explain/');
const actual=page==='laboratorios'?'laboratorios':'inicio';
const cabecera=marco.cabecera.replaceAll(`data-nav="${actual}"`, `data-nav="${actual}" aria-current="page"`);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Robot explorador</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sebastián Valderas Neculqueo" />
    <meta name="theme-color" content="#f1f1e9" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}img/icono.svg`} type="image/svg+xml" />
    <link rel="preload" href={`${base}fuentes/archivo-latin-variable.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href={`${base}css/marco.css`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Robot explorador`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://svn11x.github.io/tesis_explain/img/social.png" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-experience={page}>
    <Fragment set:html={cabecera} />
    <main id="contenido"><slot /></main>
    <Fragment set:html={marco.pie} />
    <script is:inline src={`${base}js/marco.js`} defer></script>
    <script>
      import { initExperience } from '../lib/experience';
      initExperience();
    </script>
  </body>
</html>
