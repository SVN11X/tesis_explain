---
import '../styles/experience.css';
const {title, description, page='inicio'} = Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical=new URL(page==='inicio'?'':`${page}.html`,'https://svn11x.github.io/tesis_explain/');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Robot explorador</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sebastián Valderas Neculqueo" />
    <meta name="theme-color" content="#f1f1e9" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}img/icono.svg`} type="image/svg+xml" />
    <link rel="preload" href={`${base}fuentes/archivo-latin-variable.woff2`} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Robot explorador`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://svn11x.github.io/tesis_explain/img/social.png" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-experience={page}>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href={base} aria-label="Robot explorador, inicio"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M16 3v6M16 23v6M3 16h6M23 16h6"/><circle cx="16" cy="16" r="8"/><circle cx="16" cy="16" r="2"/></svg><span>ROBOT<br/>EXPLORADOR<span class="brand-dot">.</span></span></a>
      <nav class="desktop-nav nav-estatica" aria-label="Navegación principal">
        <a href={`${base}#experiencia`} aria-current={page==='inicio'?'page':undefined}>Experiencia</a>
        <a href={`${base}laboratorios.html`} aria-current={page==='laboratorios'?'page':undefined}>Laboratorios</a>
        <a href={`${base}robot.html`}>El robot</a><a href={`${base}resultados.html`}>Evidencia</a>
      </nav>
      <div class="header-actions"><button class="search-trigger" data-search-open aria-label="Buscar en la guía" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/></svg><span class="mono">⌘ K</span></button><a class="header-build" href={`${base}replicar.html`}>Construir <span aria-hidden="true">↗</span></a><details class="mobile-menu"><summary aria-label="Abrir navegación">Menú <span aria-hidden="true">+</span></summary><nav aria-label="Navegación móvil"><a href={`${base}#experiencia`}>Experiencia</a><a href={`${base}laboratorios.html`}>Laboratorios</a><a href={`${base}robot.html`}>El robot</a><a href={`${base}resultados.html`}>Evidencia</a><a href={`${base}replicar.html`}>Construir</a><a href={`${base}recursos.html`}>Recursos</a></nav></details></div>
    </header>
    <main id="contenido"><slot /></main>
    <aside class="academic-note aviso-academico" aria-label="Estado de la investigación"><div><span class="status-dot" aria-hidden="true"></span><strong>En revisión por comité</strong><p>Explicaciones, parámetros y resultados pueden cambiar tras la revisión.</p></div><a href={`${base}recursos.html#estado-academico`}>Estado y procedencia ↗</a></aside>
    <footer class="site-footer" id="sobre"><div class="footer-top"><a class="footer-title" href={base}>Explorar es<br/><span>hacer preguntas.</span> <span aria-hidden="true">↗</span></a><div class="footer-links"><a href={`${base}#temas`}>Guía completa</a><a href={`${base}preguntas.html`}>Preguntas frecuentes</a><a href={`${base}recursos.html`}>Recursos y glosario</a><a href={`${base}bibliografia.html`}>Bibliografía</a><a href="https://github.com/SVN11X/tesis_explain">Código fuente ↗</a></div></div><div class="footer-bottom"><p>Trabajo de titulación · Ingeniería Civil Electrónica · UTEM</p><p>Sebastián Valderas Neculqueo<br/><span>Profesor guía: Patricio Galarce Acevedo</span></p><a href="#contenido">Volver arriba ↑</a></div></footer>
    <dialog class="search-dialog" aria-label="Buscar en la guía"><div class="search-heading"><label for="guide-search">Buscar en la guía</label><button data-search-close aria-label="Cerrar búsqueda">×</button></div><input id="guide-search" type="search" placeholder="LiDAR, odometría, control…" autocomplete="off"/><p class="search-status" role="status">Escribe al menos dos caracteres.</p><ul class="search-results"></ul><p class="search-help mono">ESC PARA CERRAR · ENLACES A LAS SECCIONES ORIGINALES</p></dialog>
    <script>
      import { initExperience } from '../lib/experience';
      initExperience();
    </script>
  </body>
</html>
