---
import '../styles/experience.css';
// Metadatos del tema, cabecera, aviso académico, pie y buscador comunes a todo el sitio: scripts/datos.py los genera desde
// scripts/plantillas/, igual que en las páginas de la guía.
import marco from '../generado/marco.json';
import marcoCss from '../../public/css/marco.css?raw';
// css/marco.css va dentro del HTML: como hoja aparte retrasa el primer pintado un viaje de red (docs/decisions/0007).
const {title, description, page='inicio'} = Astro.props;
const base=import.meta.env.BASE_URL.replace(/\/?$/, '/');
const canonical=new URL(page==='inicio'?'':`${page}.html`,'https://svn11x.github.io/tesis_explain/');
const actual=page==='laboratorios'?'laboratorios':'inicio';
const cabecera=marco.cabecera.replaceAll(`data-nav="${actual}"`, `data-nav="${actual}" aria-current="page"`);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Robot explorador</title>
    <meta name="description" content={description} />
    <meta name="author" content="Sebastián Valderas Neculqueo" />
    <Fragment set:html={marco.tema} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}img/icono.svg`} type="image/svg+xml" />
    <style set:html={marcoCss}></style>
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Robot explorador`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://svn11x.github.io/tesis_explain/img/social.png" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body data-experience={page}>
    <Fragment set:html={cabecera} />
    <main id="contenido"><slot /></main>
    <Fragment set:html={marco.pie} />
    <script is:inline src={`${base}js/marco.js`} defer></script>
    <script>
      import { initExperience } from '../lib/experience';
      initExperience();
    </script>
  </body>
</html>
